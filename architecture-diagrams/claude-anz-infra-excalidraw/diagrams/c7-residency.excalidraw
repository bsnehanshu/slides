   "seed": 8196165,
   "version": 1,
   "versionNonce": 108394515,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Check the real destination list: aws bedrock get-inference-profile --inference-profile-identifier au.anthropic.claude-sonnet-4-5-20250929-v1:0\nNZ data on au. can be processed in Australia. In-region keeps it in one Region, if the model is offered there.\nEnforce with an IAM condition on bedrock:InferenceProfileArn plus an SCP. Residency is about location; sovereignty (whose law applies) is a question for legal.",
   "originalText": "Check the real destination list: aws bedrock get-inference-profile --inference-profile-identifier au.anthropic.claude-sonnet-4-5-20250929-v1:0\nNZ data on au. can be processed in Australia. In-region keeps it in one Region, if the model is offered there.\nEnforce with an IAM condition on bedrock:InferenceProfileArn plus an SCP. Residency is about location; sovereignty (whose law applies) is a question for legal.",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
