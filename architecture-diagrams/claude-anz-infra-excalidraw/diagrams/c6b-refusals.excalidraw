  },
  {
   "id": "t22",
   "type": "text",
   "x": 18,
   "y": 672.25,
   "width": 1193,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "g-bed"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 8180327,
   "version": 1,
   "versionNonce": 108185057,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Server-side fallbacks (\"default\") are Claude API only. On Bedrock, use the Anthropic SDK refusal-fallback middleware or retry on another model yourself.\nSome categories have a recommended fallback model; others don't, and the refusal stands. Reset the conversation before you retry.",
   "originalText": "Server-side fallbacks (\"default\") are Claude API only. On Bedrock, use the Anthropic SDK refusal-fallback middleware or retry on another model yourself.\nSome categories have a recommended fallback model; others don't, and the refusal stands. Reset the conversation before you retry.",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t23",
   "type": "text",
   "x": 0,
   "y": 780,
   "width": 1039,
   "height": 40,
   "angle": 0,
   "strokeColor": "#757575",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 8188246,
   "version": 1,
   "versionNonce": 108289786,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Mythos 5.1 (same model as Fable 5.1, looser safeguards) is trusted access that Anthropic grants directly. AWS can't add customers.\nCheck which models and platforms CVP and LSVP cover on Anthropic's pages before you promise a customer a path.",
   "originalText": "Mythos 5.1 (same model as Fable 5.1, looser safeguards) is trusted access that Anthropic grants directly. AWS can't add customers.\nCheck which models and platforms CVP and LSVP cover on Anthropic's pages before you promise a customer a path.",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
