   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Anthropic and the US NNSA built a classifier that separates concerning from benign nuclear conversations, 96% accurate in testing.\nIt runs in Anthropic's misuse detection (Aug 2025). The point: nuclear energy and medicine questions get through, weapons questions don't.",
   "originalText": "Anthropic and the US NNSA built a classifier that separates concerning from benign nuclear conversations, 96% accurate in testing.\nIt runs in Anthropic's misuse detection (Aug 2025). The point: nuclear energy and medicine questions get through, weapons questions don't.",
