   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Classifiers screen the input and stream-check the output, blocking mid-response if needed (C3b).\nOn top of that sit the customer's own guardrails, such as Amazon Bedrock Guardrails.",
   "originalText": "Classifiers screen the input and stream-check the output, blocking mid-response if needed (C3b).\nOn top of that sit the customer's own guardrails, such as Amazon Bedrock Guardrails.",
